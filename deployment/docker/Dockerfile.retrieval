# Team 2 - Threat Retrieval & Matching service (v2 pipeline), CPU only. Port 8000.
#
# The image holds the code and the Python packages only. The indexes and models (about 8 GB,
# "the retrieval data") are NOT in the image: they are mounted read-only at /data when the
# container runs (docker-compose.yml does this). See docs/DOCKER_SETUP.md.
#
# Base images are pinned to an exact version (the sha256 digest), so every build gets the same
# system. To update on purpose: docker buildx imagetools inspect python:3.12-slim (the "Digest:"
# line), then run the checks in docs/DOCKER_SETUP.md and change the digest here.
# Python 3.12 = the version the service is tested and benchmarked with (IITGN server).
FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
COPY --from=ghcr.io/astral-sh/uv:latest@sha256:af22a52f5eafef3d78e551599d405c02df61919d18028f0cea8eda93bc9986d0 /uv /uvx /bin/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    # Everything is read from /data; nothing is ever downloaded while the service runs.
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    CUDA_VISIBLE_DEVICES="" \
    # The served configuration (same as on the server): v2 pipeline, reranker off.
    TRE_PIPELINE=v2 \
    TRE_RERANK_WEIGHT=0 \
    TRE_STORE_DIR=/data/store \
    TRE_LEXICAL_DIR=/data/lexical \
    TRE_DENSE_DIR=/data/dense \
    TRE_ATTACK_DIR=/data/attack \
    TRE_TECH_DIR=/data/techniques \
    TRE_MODEL_DIR=/data/models \
    TRE_CONFIG_PATH=/app/config/retrieval_config.yaml \
    # Writable files (PoC search cache) go to /state, a Docker volume; /data stays read-only.
    TRE_DATA_DIR=/state \
    HF_HOME=/state/huggingface \
    TMPDIR=/tmp

WORKDIR /app

# 1. CPU-only PyTorch, the same version as on the server (2.6.0).
RUN uv pip install --system --no-cache torch==2.6.0 --index-url https://download.pytorch.org/whl/cpu
# 2. Every other package at the exact version of requirements-retrieval.lock.
COPY requirements-retrieval-docker.txt .
RUN uv pip install --system --no-cache -r requirements-retrieval-docker.txt

COPY threat_retrieval_engine/ threat_retrieval_engine/
COPY config/ config/
COPY scripts/docker/retrieval_data.py scripts/docker/retrieval_start.py scripts/docker/

# Run as an ordinary user, not root.
RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin app \
    && mkdir -p /data /state \
    && chown app:app /state
USER app

EXPOSE 8000
# "Healthy" = the indexes and models are loaded, the warm-up questions were answered (the start
# script then writes /tmp/retrieval-warm) and the service answers. Takes 1-3 minutes after start.
HEALTHCHECK --interval=30s --timeout=10s --start-period=300s --retries=3 \
    CMD ["python", "-c", "import os,sys,urllib.request; sys.exit(0 if os.path.exists('/tmp/retrieval-warm') and urllib.request.urlopen('http://127.0.0.1:8000/api/v1/ready', timeout=8).status == 200 else 1)"]
CMD ["python", "scripts/docker/retrieval_start.py"]
