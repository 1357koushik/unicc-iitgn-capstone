FROM python:3.11 AS builder
WORKDIR /build
COPY requirements-retrieval.txt .
COPY pyproject.toml .
RUN pip install --no-cache-dir --prefix=/install -r requirements-retrieval.txt

FROM python:3.11-slim
WORKDIR /app
COPY --from=builder /install /usr/local
COPY threat_retrieval_engine/ threat_retrieval_engine/
COPY knowledge_foundation/ knowledge_foundation/
COPY config/ config/
COPY data/ data/
EXPOSE 8000
CMD ["uvicorn", "threat_retrieval_engine.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
